@TestServer_HostAddress = http://localhost:5000
@ApiKey = replace-with-your-api-key

POST {{TestServer_HostAddress}}/api/message
Content-Type: application/json
X-API-Key: {{ApiKey}}

{
  "message": "Ping"
}

